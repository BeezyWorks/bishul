{
  "name": "tavshil",
  "version": "2.13.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "start": "expo start --web",
    "build:web": "expo export --platform web",
    "dev:api": "wrangler dev",
    "deploy:prod": "wrangler deploy",
    "db:generate": "pnpm --filter @tavshil/worker db:generate",
    "db:migrate:local": "wrangler d1 migrations apply tavshil --local",
    "db:migrate:remote": "wrangler d1 migrations apply tavshil --remote",
    "test": "pnpm -r --filter ./packages/core --filter ./worker test",
    "typecheck": "tsc --noEmit && pnpm -r --filter ./packages/core --filter ./worker typecheck",
    "format": "prettier --write .",
    "ship": "scripts/build-local.sh",
    "build:local": "scripts/build-local.sh --no-submit",
    "release:dry": "npx --yes -p semantic-release@24 -p @semantic-release/changelog@6 -p @semantic-release/git@10 semantic-release --dry-run --no-ci"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/instrument-sans": "^0.4.2",
    "@expo/ui": "~57.0.26",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@tanstack/query-async-storage-persister": "^5.107.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-persist-client": "^5.107.1",
    "@tavshil/core": "workspace:*",
    "expo": "~57.0.25",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.17",
    "expo-font": "~57.0.1",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.25",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.3",
    "expo-widgets": "~57.0.28",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-qrcode-svg": "^6.3.54",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.16.1",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.7",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "wrangler": "^4.40.0"
  }
}
