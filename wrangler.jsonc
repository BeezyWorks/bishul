{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tavshil",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  // Served at tavshil.baderech.app (the zone baderech.app is on Cloudflare).
  "routes": [{ "pattern": "tavshil.baderech.app", "custom_domain": true }],
  "build": { "command": "pnpm build:web" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/v1/*", "/mcp", "/.well-known/*", "/health", "/internal/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tavshil",
      "database_id": "c1427926-bb1b-4f3a-8ee7-0c730c909fb2",
      "migrations_dir": "migrations",
    },
  ],
  // Sessions are checked against the accounts Worker over a service binding.
  "services": [{ "binding": "AUTH", "service": "beezyworks-accounts" }],
  // Throttles repeated bad API keys and bad tokens (per client IP).
  "ratelimits": [
    { "name": "AUTH_LIMIT", "namespace_id": "4101", "simple": { "limit": 20, "period": 60 } },
  ],
  "vars": {
    "AUTH_URL": "https://auth.baderech.app",
    "PUBLIC_URL": "https://tavshil.baderech.app",
  },
}
