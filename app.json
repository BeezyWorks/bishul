{
  "expo": {
    "name": "Tavshil",
    "slug": "tavshil",
    "version": "0.1.0",
    "scheme": "tavshil",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "web"
    ],
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#2E6A4E"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "beezyworkstudios",
    "icon": "./assets/brand/icon.png",
    "ios": {
      "bundleIdentifier": "com.beezyworks.tavshil",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b89c8474-4e3f-4ca9-b349-e2e90ec3eb45"
      }
    }
  }
}
