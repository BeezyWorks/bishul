{
  "expo": {
    "name": "Tavshil",
    "slug": "tavshil",
    "version": "0.1.0",
    "scheme": "tavshil",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "web"],
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#2E6A4E",
          "sounds": [
            "./assets/sounds/alarm-bell.wav",
            "./assets/sounds/alarm-chimes.wav",
            "./assets/sounds/alarm-marimba.wav",
            "./assets/sounds/alarm-beeps.wav"
          ]
        }
      ],
      "expo-audio",
      "expo-secure-store",
      "expo-widgets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "beezyworkstudios",
    "icon": "./assets/brand/icon.png",
    "ios": {
      "bundleIdentifier": "com.beezyworks.tavshil",
      "supportsTablet": true,
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b89c8474-4e3f-4ca9-b349-e2e90ec3eb45"
      }
    }
  }
}
